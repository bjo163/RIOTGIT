# Bind to localhost by default. Put a trusted TLS reverse proxy in front for remote access.
RIOTGIT_BIND=127.0.0.1:8787

# Required for repository administration endpoints.
# Generate with: openssl rand -hex 32
RIOTGIT_API_TOKEN=replace-with-a-long-random-secret

# Local persistent data. Keep outside any public web root.
RIOTGIT_DATABASE_PATH=data/riotgit.db
RIOTGIT_STORAGE_ROOT=data/repositories

# Set an absolute path when Git is not available on PATH.
RIOTGIT_GIT_BIN=git

RUST_LOG=riotgit_api=info,sqlx=warn
